# Production API mode.
APP_ENV=production
DATA_SOURCE_PRODUCTION=api
API_BASE_URL_PRODUCTION=https://api.37club.net
API_DOMAIN=api.37club.net

# Optional server admin setting.
OWNER_OPEN_ID=

COGNITO_ISSUER=https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_Pc1N2LdIy
COGNITO_DOMAIN=https://ap-northeast-1pc1n2ldiy.auth.ap-northeast-1.amazoncognito.com
COGNITO_CLIENT_ID=7c0ffqppgk4501n8oboi4mridq
COGNITO_SCOPES=openid email

# Server HTTP hardening.
# Native app requests usually have no browser Origin. Add only trusted web origins if needed.
API_ALLOWED_ORIGINS=
API_CORS_CREDENTIALS=false
API_BODY_LIMIT=2mb
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
API_SENSITIVE_RATE_LIMIT_MAX=30

# Production Docker Compose / MySQL.
# Replace CHANGE_ME values on the server secret file before first deploy.
PORT=3000
MYSQL_DATABASE=37club
MYSQL_USER=37club_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
DATABASE_URL=mysql://37club_app:CHANGE_ME@mysql:3306/37club

# Server-side object storage.
# Production should use an IAM access key injected on the server, not AWS_PROFILE.
AWS_REGION=ap-northeast-1
S3_BUCKET=37club-production-372595555372-ap-northeast-1-assets
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
