# Production API mode.
APP_ENV=production
DATA_SOURCE_PRODUCTION=api
# TODO API_BASE_URL_PRODUCTION=https://api.example.com
API_DOMAIN=api.example.com

# Optional server admin setting.
OWNER_OPEN_ID=

COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_SCOPES=openid email

# Server HTTP hardening.
# Native app requests usually have no browser Origin. Add only trusted web origins if needed.
API_ALLOWED_ORIGINS=
API_CORS_CREDENTIALS=false
API_BODY_LIMIT=2mb
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
API_SENSITIVE_RATE_LIMIT_MAX=30

# Production Docker Compose / MySQL.
# Replace CHANGE_ME values on the server secret file before first deploy.
PORT=3000
MYSQL_DATABASE=37club
MYSQL_USER=37club_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME
DATABASE_URL=mysql://37club_app:CHANGE_ME@mysql:3306/37club

# Server-side object storage.
# Production should use an IAM access key injected on the server, not AWS_PROFILE.
AWS_REGION=ap-northeast-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
