# Copy one of .env.mock / .env.local / .env.development / .env.production to .env.
APP_ENV=local

# Set only the values for the active APP_ENV.
DATA_SOURCE_LOCAL=api
API_BASE_URL_LOCAL=http://localhost:3000
DATABASE_URL=mysql://admin:root@127.0.0.1:3306/37club

# Production compose / API domain placeholders.
API_DOMAIN=api.example.com
PORT=3000
MYSQL_DATABASE=37club
MYSQL_USER=37club_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Optional server admin setting.
OWNER_OPEN_ID=

# Cognito OAuth/OIDC settings. These values are public client configuration, not secrets.
COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_SCOPES=openid email

# Server-side object storage settings. Store AWS credentials in an AWS profile or
# workload IAM role, not in this file.
AWS_PROFILE=
AWS_REGION=ap-northeast-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Server HTTP hardening. Local defaults are used when these are omitted.
API_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
API_CORS_CREDENTIALS=false
API_BODY_LIMIT=50mb
API_RATE_LIMIT_ENABLED=false
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
API_SENSITIVE_RATE_LIMIT_MAX=30

# Server-only shared token used by the Topic management Lambda. Generate at
# least 32 random characters and never include it in Lambda input JSON.
TOPIC_MANAGEMENT_SERVICE_TOKEN=
