# Copy one of .env.mock / .env.local / .env.development / .env.production to .env.
APP_ENV=local

# Set only the values for the active APP_ENV.
DATA_SOURCE_LOCAL=api
API_BASE_URL_LOCAL=http://localhost:3000
DATABASE_URL=mysql://admin:root@127.0.0.1:3306/37club

# Optional server admin setting.
OWNER_OPEN_ID=

# Cognito OAuth/OIDC settings. These values are public client configuration, not secrets.
COGNITO_ISSUER=
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=
COGNITO_SCOPES=openid email

# Server-side object storage settings. Store AWS credentials in an AWS profile or
# workload IAM role, not in this file.
AWS_PROFILE=
AWS_REGION=ap-northeast-1
S3_BUCKET=
